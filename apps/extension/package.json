{
  "name": "moat",
  "private": true,
  "version": "0.1.2",
  "description": "Moat — a minimalist Chrome extension that blocks distracting sites with a toggle and a one-click 1-hour focus mode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "test": "pnpm build && playwright test",
    "test:headed": "pnpm build && playwright test --headed",
    "test:install": "playwright install chromium",
    "package": "pnpm build && rm -f ../../moat-$npm_package_version.zip && cd dist && zip -rq ../../../moat-$npm_package_version.zip .",
    "screenshots": "pnpm build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
